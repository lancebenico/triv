# Copy to .env (local) or paste these as environment variables on your host.
# Leave blank/unset to fall back to XAMPP defaults (localhost / root / no password).

DB_HOST=mysql-xxxxx.aivencloud.com
DB_PORT=12345
DB_NAME=triv_db
DB_USER=avnadmin
DB_PASS=your-password-here

# Hosted MySQL (Aiven, TiDB Cloud, PlanetScale) requires TLS:
DB_SSL=1
# Optional: path to the provider's CA bundle for full certificate verification
# DB_SSL_CA=/var/www/html/ca.pem
